<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:visibility="visible">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        tools:context=".MainActivity"
        tools:background="@color/black">

        <LinearLayout
            android:id="@+id/linearLayout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <Button
                android:id="@+id/left"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="bottom|left"
                android:paddingLeft="64dp"
                android:textColor="@color/white"
                android:visibility="visible" />

            <Button
                android:id="@+id/right"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:gravity="bottom|right"
                android:paddingRight="64dp"
                android:textColor="@color/white"
                android:visibility="visible" />
        </LinearLayout>

        <Button
            android:id="@+id/tilt_left"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="60dp"
            android:layout_height="0dp"
            android:text="@string/tilt"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/tilt_right" />

        <Button
            android:id="@+id/tilt_right"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="60dp"
            android:layout_height="120dp"
            android:text="@string/tilt"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/tilt_bottom"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_marginStart="32dp"
            android:layout_marginEnd="32dp"
            android:text="@string/tilt"
            android:textColor="@color/white"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="@+id/tilt_left"
            app:layout_constraintEnd_toStartOf="@+id/tilt_right"
            app:layout_constraintStart_toEndOf="@+id/tilt_left" />

        <Button
            android:id="@+id/plunger"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@android:color/transparent"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/linearLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/settingsbtn"
            app:rippleColor="@android:color/transparent" />

        <ImageButton
            android:id="@+id/playpause"
            style="@android:style/Widget.DeviceDefault.ImageButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:background="@drawable/text_background"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/pause"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="@id/replay"
            app:layout_constraintTop_toBottomOf="@id/settingsbtn" />

        <ImageButton
            android:id="@+id/settingsbtn"
            style="@android:style/Widget.DeviceDefault.ImageButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="40dp"
            android:background="@drawable/text_background"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/settings"
            app:layout_constraintStart_toStartOf="@id/replay"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/replay"
            style="@android:style/Widget.DeviceDefault.ImageButton"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/text_background"
            android:minWidth="48dp"
            android:minHeight="48dp"
            android:src="@drawable/replay"
            android:visibility="visible"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/playpause" />

        <TextView
            android:id="@+id/missiontxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/text_background"
            android:elevation="2dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="text box" />

        <TextView
            android:id="@+id/ballstxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:layout_marginEnd="20dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_horizontal|center_vertical"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/text_background"
            android:elevation="2dp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            tools:text="text box" />

        <TextView
            android:id="@+id/infotxt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/text_background"
            android:elevation="2dp"
            android:visibility="visible"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:text="text box" />

        <TextView
            android:id="@+id/txtscore"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="40dp"
            android:layout_marginStart="20dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_horizontal"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@drawable/text_background"
            android:elevation="2dp"
            android:visibility="visible"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            tools:text="10000000" />

        <ImageView
            android:id="@+id/cheatAlert"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:src="@drawable/warn"
            android:visibility="invisible"
            app:layout_constraintBottom_toBottomOf="@+id/playpause"
            app:layout_constraintEnd_toEndOf="@+id/settingsbtn"
            app:layout_constraintStart_toStartOf="@+id/settingsbtn"
            app:layout_constraintTop_toBottomOf="@+id/settingsbtn" />

        <!-- Light Debug Panel -->
        <LinearLayout
            android:id="@+id/lightDebugPanel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="8dp"
            android:background="@android:color/transparent"
            android:visibility="gone"
            android:clickable="true"
            android:focusable="true"
            android:elevation="10dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="8dp"
            android:layout_marginTop="8dp">

            <TextView
                android:id="@+id/lightDebugTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Light Debug"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/currentLightText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current: None"
                android:textColor="#FFFF00"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/prevLightBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Prev"
                    android:textSize="10sp"
                    android:minWidth="48dp"
                    android:padding="4dp" />

                <Button
                    android:id="@+id/nextLightBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Next"
                    android:textSize="10sp"
                    android:minWidth="48dp"
                    android:padding="4dp"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/toggleTableLightBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Table"
                    android:textSize="10sp"
                    android:minWidth="48dp"
                    android:padding="4dp" />

                <Button
                    android:id="@+id/toggleHDRLightBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="HDR"
                    android:textSize="10sp"
                    android:minWidth="48dp"
                    android:padding="4dp"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- Property Editing Section -->
            <TextView
                android:id="@+id/propsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Properties:"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:layout_marginTop="8dp" />

            <!-- Color: R -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="R"
                    android:textColor="#FF6666"
                    android:textSize="10sp" />
                <SeekBar
                    android:id="@+id/sliderR"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100" />
                <TextView
                    android:id="@+id/valueR"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="1.0"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Color: G -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="G"
                    android:textColor="#66FF66"
                    android:textSize="10sp" />
                <SeekBar
                    android:id="@+id/sliderG"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100" />
                <TextView
                    android:id="@+id/valueG"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="1.0"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Color: B -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="B"
                    android:textColor="#6666FF"
                    android:textSize="10sp" />
                <SeekBar
                    android:id="@+id/sliderB"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:max="200"
                    android:progress="100" />
                <TextView
                    android:id="@+id/valueB"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="1.0"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Size -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="Sz"
                    android:textColor="#FFFF66"
                    android:textSize="10sp" />
                <SeekBar
                    android:id="@+id/sliderSize"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:max="100"
                    android:progress="20" />
                <TextView
                    android:id="@+id/valueSize"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="0.02"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Intensity -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="Int"
                    android:textColor="#FF66FF"
                    android:textSize="10sp" />
                <SeekBar
                    android:id="@+id/sliderIntensity"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:max="2000"
                    android:progress="600" />
                <TextView
                    android:id="@+id/valueIntensity"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="600"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Glow -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="20dp"
                    android:layout_height="wrap_content"
                    android:text="Glw"
                    android:textColor="#66FFFF"
                    android:textSize="10sp" />
                <SeekBar
                    android:id="@+id/sliderGlow"
                    android:layout_width="0dp"
                    android:layout_height="24dp"
                    android:layout_weight="1"
                    android:max="300"
                    android:progress="100" />
                <TextView
                    android:id="@+id/valueGlow"
                    android:layout_width="32dp"
                    android:layout_height="wrap_content"
                    android:text="1.0"
                    android:textColor="#FFFFFF"
                    android:textSize="9sp" />
            </LinearLayout>

            <!-- Position Display -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="4dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pos: "
                    android:textColor="#AAAAAA"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/valuePosX"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="X:0.0000"
                    android:textColor="#00FF00"
                    android:textSize="10sp" />
                <TextView
                    android:id="@+id/valuePosY"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=" Y:0.0000"
                    android:textColor="#00FF00"
                    android:textSize="10sp" />
                <CheckBox
                    android:id="@+id/checkLocked"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Locked"
                    android:textColor="#FF6666"
                    android:textSize="10sp"
                    android:layout_marginStart="8dp"
                    android:buttonTint="#FF6666" />
            </LinearLayout>

            <!-- Nudge Buttons -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nudge:"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:layout_marginTop="4dp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <Button
                    android:id="@+id/nudgeLeftBtn"
                    android:layout_width="36dp"
                    android:layout_height="28dp"
                    android:text="◀"
                    android:textSize="10sp"
                    android:padding="0dp" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <Button
                        android:id="@+id/nudgeUpBtn"
                        android:layout_width="36dp"
                        android:layout_height="28dp"
                        android:text="▲"
                        android:textSize="10sp"
                        android:padding="0dp" />

                    <Button
                        android:id="@+id/nudgeDownBtn"
                        android:layout_width="36dp"
                        android:layout_height="28dp"
                        android:text="▼"
                        android:textSize="10sp"
                        android:padding="0dp" />

                </LinearLayout>

                <Button
                    android:id="@+id/nudgeRightBtn"
                    android:layout_width="36dp"
                    android:layout_height="28dp"
                    android:text="▶"
                    android:textSize="10sp"
                    android:padding="0dp" />

            </LinearLayout>

            <!-- Preset Section -->
            <TextView
                android:id="@+id/presetLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Preset:"
                android:textColor="#AAAAAA"
                android:textSize="10sp"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/currentPresetText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="(none)"
                android:textColor="#00FFFF"
                android:textSize="11sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/createPresetBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Create"
                    android:textSize="9sp"
                    android:minWidth="48dp"
                    android:padding="4dp" />

                <Button
                    android:id="@+id/applyPresetBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Apply"
                    android:textSize="9sp"
                    android:minWidth="48dp"
                    android:padding="4dp"
                    android:layout_marginStart="4dp" />

                <Button
                    android:id="@+id/clearPresetBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:text="Clear"
                    android:textSize="9sp"
                    android:minWidth="40dp"
                    android:padding="4dp"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

            <!-- Save Light Button -->
            <Button
                android:id="@+id/saveLightBtn"
                android:layout_width="match_parent"
                android:layout_height="32dp"
                android:text="Save This Light"
                android:textSize="10sp"
                android:layout_marginTop="8dp"
                android:backgroundTint="#228B22" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="4dp">

                <Button
                    android:id="@+id/swapSideBtn"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="Swap"
                    android:textSize="10sp"
                    android:padding="4dp" />

                <Button
                    android:id="@+id/closeLightDebugBtn"
                    android:layout_width="0dp"
                    android:layout_height="32dp"
                    android:layout_weight="1"
                    android:text="Close"
                    android:textSize="10sp"
                    android:padding="4dp"
                    android:layout_marginStart="4dp" />

            </LinearLayout>

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/bottomsheet"
        android:layout_width="150dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="16dp"
        android:layout_marginLeft="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginRight="16dp"
        android:background="@android:color/background_dark"
        app:behavior_hideable="true"
        app:behavior_peekHeight="25dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        tools:visibility="gone">

        <ImageView
            android:id="@+id/imageView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:src="@android:drawable/arrow_up_float"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <Button
            android:id="@+id/bottomPlunger"
            style="@style/Widget.AppCompat.Button.Borderless"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginLeft="8dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="8dp"
            android:layout_marginRight="8dp"
            android:text="@string/plunger"
            android:textColor="@color/white"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/imageView" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>